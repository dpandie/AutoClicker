<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 自定义标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/colorPrimary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                android:contentDescription="返回"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clicker_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 内容区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 模式切换卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btnModeCoordinate"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="坐标模式"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/btn_primary_bg"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnModeOcr"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="OCR模式"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:background="@drawable/edit_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========== 坐标模式内容 ========== -->
            <LinearLayout
                android:id="@+id/layoutCoordinateMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 点击间隔卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/interval_label"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/btnIntervalMinus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="−"
                                android:textSize="22sp"
                                android:textColor="@color/white"
                                android:background="@drawable/btn_primary_bg"
                                android:clickable="true"
                                android:focusable="true" />

                            <EditText
                                android:id="@+id/etInterval"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:inputType="number"
                                android:text="100"
                                android:textSize="18sp"
                                android:textColor="@color/text_primary"
                                android:gravity="center"
                                android:background="@drawable/edit_bg"
                                android:hint="@string/hint_interval"
                                android:textColorHint="@color/text_hint" />

                            <TextView
                                android:id="@+id/btnIntervalPlus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="+"
                                android:textSize="22sp"
                                android:textColor="@color/white"
                                android:background="@drawable/btn_primary_bg"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="范围：1 ~ 60000 毫秒"
                            android:textSize="11sp"
                            android:textColor="@color/text_hint" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 点击次数卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/count_label"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/count_infinite"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginEnd="8dp" />

                                <Switch
                                    android:id="@+id/switchInfinite"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutCountInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/btnCountMinus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="−"
                                android:textSize="22sp"
                                android:textColor="@color/white"
                                android:background="@drawable/btn_primary_bg"
                                android:clickable="true"
                                android:focusable="true" />

                            <EditText
                                android:id="@+id/etCount"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:inputType="number"
                                android:text="100"
                                android:textSize="18sp"
                                android:textColor="@color/text_primary"
                                android:gravity="center"
                                android:background="@drawable/edit_bg"
                                android:hint="@string/hint_count"
                                android:textColorHint="@color/text_hint" />

                            <TextView
                                android:id="@+id/btnCountPlus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="+"
                                android:textSize="22sp"
                                android:textColor="@color/white"
                                android:background="@drawable/btn_primary_bg"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 坐标模式运行状态 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvRunningStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未运行"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvClickCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 坐标模式开始/停止按钮 -->
                <Button
                    android:id="@+id/btnStartStop"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_start"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary_bg"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvFloatingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/floating_ball_hint"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:gravity="center"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ========== OCR 模式内容 ========== -->
            <LinearLayout
                android:id="@+id/layoutOcrMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 目标文字卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="目标文字"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etTargetText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:inputType="text"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:background="@drawable/edit_bg"
                            android:hint="输入要匹配的文字"
                            android:textColorHint="@color/text_hint"
                            android:singleLine="true" />

                        <!-- 匹配模式 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="精确匹配"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary" />

                            <Switch
                                android:id="@+id/switchExactMatch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="包含匹配"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="精确匹配：文字完全相同；包含匹配：文字中包含目标即可"
                            android:textSize="11sp"
                            android:textColor="@color/text_hint" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 扫描参数卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="扫描与点击参数"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <!-- 扫描间隔 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="扫描间隔(ms)"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary" />

                            <EditText
                                android:id="@+id/etOcrScanInterval"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:inputType="number"
                                android:text="500"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary"
                                android:gravity="center"
                                android:background="@drawable/edit_bg"
                                android:textColorHint="@color/text_hint" />

                        </LinearLayout>

                        <!-- 匹配后点击次数 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="点击次数"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary" />

                            <EditText
                                android:id="@+id/etOcrClickCount"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:inputType="number"
                                android:text="1"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary"
                                android:gravity="center"
                                android:background="@drawable/edit_bg"
                                android:textColorHint="@color/text_hint" />

                        </LinearLayout>

                        <!-- 点击间隔 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="点击间隔(ms)"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary" />

                            <EditText
                                android:id="@+id/etOcrClickInterval"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:inputType="number"
                                android:text="100"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary"
                                android:gravity="center"
                                android:background="@drawable/edit_bg"
                                android:textColorHint="@color/text_hint" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="扫描间隔越短识别越快但越耗电；点击次数为匹配后自动点击的次数"
                            android:textSize="11sp"
                            android:textColor="@color/text_hint" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- OCR 运行状态卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvOcrStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未运行"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOcrScanCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvOcrMatchInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textColor="#FFFF9800"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvOcrClickCountDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- OCR 开始/停止按钮 -->
                <Button
                    android:id="@+id/btnOcrStartStop"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="开始OCR识别"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_ocr_bg"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvOcrHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启动后将截屏识别文字，匹配成功自动点击该文字中心位置"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:gravity="center" />

                <!-- 诊断日志悬浮入口小按钮 -->
                <TextView
                    android:id="@+id/btnToggleDiag"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:layout_gravity="end"
                    android:background="@drawable/edit_bg"
                    android:gravity="center"
                    android:text="日志"
                    android:textSize="10sp"
                    android:textColor="#FF6B6B"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:elevation="4dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>

    <!-- ====== 悬浮诊断日志面板（叠加在内容上方） ====== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDiagLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1A1A2E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="诊断日志"
                    android:textSize="14sp"
                    android:textColor="#FF6B6B"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClearDiag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="清空"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnCloseDiag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="收起"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollDiagLog"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvDiagLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="等待启动..."
                    android:textSize="11sp"
                    android:textColor="#00FF88"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />

            </ScrollView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
